# install.sh backups
*.bak-*
*.bak

# Never track: contains client names, teammates, and engagement detail.
# Keep the real file at ~/.claude/CLAUDE.md only. See claude/CLAUDE.md.template.
claude/CLAUDE.md

# Never track: Claude Code rewrites this in place (it is symlinked here), and
# it accumulates internal marketplaces and absolute local paths.
# See claude/settings.json.template for the shareable baseline.
claude/settings.json

# Local-only credentials referenced by .zshrc at runtime
.cli-proxy-api/

# machine-local shell config (client paths, local proxies, absolute paths)
home/.zshrc.local
