#!/usr/bin/env bash
# Track Claude state per tmux pane, and roll it up to the tab.
#
#   claude-tmux-alert busy   this pane's Claude is working      (purple ◐)
#   claude-tmux-alert on     this pane's Claude wants you       (green  ●)
#   claude-tmux-alert off    clear this pane
#   claude-tmux-alert seen   clear "wants you" for the pane you just focused
#                            (bound to after-select-pane / after-select-window /
#                            after-switch-client in ~/.tmux.conf)
#
# State lives on the PANE, in @claude_state (alert | busy | unset). The
# window's @claude_alert / @claude_busy are derived from all its panes:
#
#   any pane alert  -> window alert   (green wins: something needs you)
#   else any busy   -> window busy    (purple)
#   else              -> clear
#
# Storing state per window instead would make concurrent sessions clobber
# each other - a session starting work would erase another session's
# "your turn", losing the notification entirely.
#
# Contract: always exit 0 and print nothing. A hook that fails or writes to
# stdout can interfere with the session - and tmux's run-shell would surface
# stray output in a popup.
#
# --json prints "{}" instead. Codex rejects an empty hook response, so
# codex/hooks.json passes it; Claude's settings.json and the tmux hooks in
# .tmux.conf do not.
#
# Both agents drive this same script, and state is per PANE, so a tab holding
# one Claude and one codex pane rolls up correctly with no extra work.

set -uo pipefail

# Filter the flag out of the positional args rather than blanking it, so it
# works in any position. Blanking leaves an empty $1 and the action is lost.
EMIT_JSON=0
_args=()
for _a in "$@"; do
  if [ "$_a" = "--json" ]; then EMIT_JSON=1; else _args+=("$_a"); fi
done
set -- ${_args[@]+"${_args[@]}"}
emit() { [ "$EMIT_JSON" = 1 ] && printf '{}\n'; return 0; }
trap emit EXIT

command -v tmux >/dev/null || exit 0

# Recompute a window's colour from the states of all its panes.
refresh_window() {
  local win="$1" states any_alert=0 any_busy=0 s
  states="$(tmux list-panes -t "$win" -F '#{@claude_state}' 2>/dev/null)" || return
  while IFS= read -r s; do
    case "$s" in
      alert) any_alert=1 ;;
      busy)  any_busy=1 ;;
    esac
  done <<< "$states"

  if [ "$any_alert" = 1 ]; then
    tmux set-option -w  -t "$win" @claude_alert 1 2>/dev/null
    tmux set-option -uw -t "$win" @claude_busy    2>/dev/null
  elif [ "$any_busy" = 1 ]; then
    tmux set-option -uw -t "$win" @claude_alert   2>/dev/null
    tmux set-option -w  -t "$win" @claude_busy  1 2>/dev/null
  else
    tmux set-option -uw -t "$win" @claude_alert   2>/dev/null
    tmux set-option -uw -t "$win" @claude_busy    2>/dev/null
  fi
}

action="${1:-on}"

# `seen` acts on whichever pane just got focus, not on a hook's own pane.
#
# Clearing every pane in the window would be wrong: with three sessions
# stacked, landing on one shouldn't dismiss the other two. The tab stays
# green until you've actually visited each pane that wants you.
if [ "$action" = "seen" ]; then
  # The pane id is passed in by the hook as #{pane_id}, which tmux expands
  # against the HOOK's target. Resolving it here with an untargeted
  # display-message would instead give whatever window is current, which is
  # only coincidentally the same one.
  pane="${2:-}"
  [ -n "$pane" ] || pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null)"
  win="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null)"
  [ -n "$pane" ] && [ -n "$win" ] || exit 0
  # Only alerts clear. A pane that is still working stays working - looking
  # at it doesn't make Claude finish.
  [ "$(tmux show-options -pqv -t "$pane" @claude_state 2>/dev/null)" = "alert" ] &&
    tmux set-option -up -t "$pane" @claude_state 2>/dev/null
  refresh_window "$win"
  exit 0
fi

[ -n "${TMUX_PANE:-}" ] || exit 0
win="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null)" || exit 0
[ -n "$win" ] || exit 0

case "$action" in
  busy) tmux set-option -p -t "$TMUX_PANE" @claude_state busy  2>/dev/null ;;
  off)  tmux set-option -up -t "$TMUX_PANE" @claude_state      2>/dev/null ;;
  on)
    # Don't raise an alert on the pane you're already looking at: nothing
    # would ever clear it, since focusing an already-focused pane fires no
    # hook. This tests THIS pane, not just its window - a sibling pane
    # finishing in your current tab still deserves to go green.
    case "$(tmux display-message -p -t "$TMUX_PANE" \
            '#{pane_active}#{window_active}:#{session_attached}' 2>/dev/null)" in
      11:[1-9]*) tmux set-option -up -t "$TMUX_PANE" @claude_state 2>/dev/null ;;
      *)         tmux set-option -p  -t "$TMUX_PANE" @claude_state alert 2>/dev/null ;;
    esac
    ;;
esac

refresh_window "$win"
exit 0
